package com.liferay.source.formatter.dependencies.upgrade;

import org.osgi.service.component.annotations.Reference;

/**
 * @author Nícolas Moura
 */
public class UpgradeCatchAllCheck {

	public void method() {
		HtmlUtil.extractText(testEntry.getContent());

		if (true) {
			HtmlUtil.extractText(testEntry.getContent());
		}
	}

	public void method(CommerceAddress commerceAddress) {
		Region region = commerceAddress.getCountry();

		region.getCode();

		commerceAddress.getRegion(
		).getCode();
	}

	public void method(
		long companyId, long groupId, String title, int start, int end) {

		_assetVocabularyLocalService.searchVocabularies(
			companyId, groupId, title, start, end);

		_assetVocabularyService.searchVocabularies(
			companyId, groupId, title, start, end);

		_assetVocabularyService.searchVocabularies(
			companyId, 551, "test", start, end);
	}

	public void method(
		long userId, long repositoryId, long folderId, String sourceFileName, String mimeType, String title, String description, String changeLog, byte[] bytes, ServiceContext serviceContext) {

		DLAppLocalServiceUtil.addFileEntry(1234, 1234, folderId, sourceFileName, mimeType, title, description, changeLog, bytes, serviceContext);
		DLAppLocalServiceUtil.addFileEntry(userId, repositoryId, folderId, sourceFileName, mimeType, title, description, changeLog, bytes, serviceContext);
		_dlAppLocalService.addFileEntry(userId, repositoryId, folderId, sourceFileName, mimeType, title, description, changeLog, bytes, serviceContext);
	}

	@Reference
	private AssetVocabularyLocalService _assetVocabularyLocalService;

	@Reference
	private AssetVocabularyService _assetVocabularyService;

	@Reference
	private DLAppLocalService _dlAppLocalService;

}
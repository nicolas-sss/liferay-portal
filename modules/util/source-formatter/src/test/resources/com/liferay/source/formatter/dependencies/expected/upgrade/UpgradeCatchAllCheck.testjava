package com.liferay.source.formatter.dependencies.upgrade;

import com.liferay.portal.kernel.util.HtmlParser;

import com.liferay.portal.kernel.search.Sort;

import org.osgi.service.component.annotations.Reference;

/**
 * @author Nícolas Moura
 */
public class UpgradeCatchAllCheck {

	public void method() {
		_htmlParser.extractText(testEntry.getContent());

		if (true) {
			_htmlParser.extractText(testEntry.getContent());
		}
	}

	public void method(CommerceAddress commerceAddress) {
		Region region = commerceAddress.getCountry();

		region.getRegionCode();

		commerceAddress.getRegion(
		).getRegionCode();
	}

	public void method(
		long companyId, long groupId, String title, int start, int end) {

		_assetVocabularyLocalService.searchVocabularies(companyId, new long[] {groupId}, title, new int[0], start, end, new Sort());

		_assetVocabularyService.searchVocabularies(companyId, new long[] {groupId}, title, new int[0], start, end, new Sort());

		_assetVocabularyService.searchVocabularies(
			companyId, 551, "test", start, end);
	}

	public void method(
		long userId, long groupId, long repositoryId, boolean mountPoint, long parentFolderId, String name, String description, boolean hidden, ServiceContext serviceContext) {

		DLFolderLocalServiceUtil.addFolder(1234, 1234, repositoryId, mountPoint, parentFolderId, name, description, hidden, serviceContext);
		DLFolderLocalServiceUtil.addFolder(null, userId, groupId, repositoryId, mountPoint, parentFolderId, name, description, hidden, serviceContext);
		DLFolderServiceUtil.addFolder(1234, 1234, mountPoint, parentFolderId, name, description, serviceContext);
		DLFolderServiceUtil.addFolder(null, groupId, repositoryId, mountPoint, parentFolderId, name, description, serviceContext);
		_dlFolderLocalService.addFolder(null, userId, groupId, repositoryId, mountPoint, parentFolderId, name, description, hidden, serviceContext);
		_dlFolderService.addFolder(null, groupId, repositoryId, mountPoint, parentFolderId, name, description, serviceContext);
	}

	@Reference
	private AssetVocabularyLocalService _assetVocabularyLocalService;

	@Reference
	private AssetVocabularyService _assetVocabularyService;

	@Reference
	private DLFolderLocalService _dlFolderLocalService;

	@Reference
	private DLFolderService _dlFolderService;

	@Reference
	private HtmlParser _htmlParser;

}
/**
 * @author Albert Gomes Cabral
 */
public class UpgradeJavaAddCommercePriceEntryCheck {

	public void method(
		String externalReferenceCode, long cProductId, String cpInstanceUuid,
	 	long commercePriceListId, BigDecimal price, BigDecimal promoPrice,
	 	ServiceContext serviceContext){

		_commercePriceEntryLocalService.addCommercePriceEntry(
			 null, cpInstance.getCPDefinition().getCProductId(),
			 cpInstance.getCPInstanceUuid(), commercePriceList.getCommercePriceListId(),
			 price, null, serviceContext);
	}

	public void methodTwo(
		String externalReferenceCode, long cProductId, String cpInstanceUuid,
		long commercePriceListId, BigDecimal price, BigDecimal promoPrice,
		ServiceContext serviceContext){

		_commercePriceEntryLocalService.addCommercePriceEntry(
			externalReferenceCode, cProductId, cpInstanceUuid, commercePriceListId,
			price, false, promoPrice, null,
			serviceContext);
	}

	@Reference
	private CommercePriceEntryLocalService _commercePriceEntryLocalService;

}